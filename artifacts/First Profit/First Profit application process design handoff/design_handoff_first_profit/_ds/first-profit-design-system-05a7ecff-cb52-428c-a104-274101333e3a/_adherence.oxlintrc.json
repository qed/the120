{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/awards/**",
              "components/celebration/**",
              "components/ledger/**",
              "components/lib/**",
              "components/primitives/**",
              "components/review/**",
              "components/status/**",
              "components/tasks/**",
              "components/wisdom/**",
              "ui_kits/hq/**",
              "ui_kits/parent/**",
              "ui_kits/trail/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Inter|Spline Sans Mono))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Inter, Spline Sans Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:skin|variant|size|phase|icon|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: skin, variant, size, phase, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|accent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crest'] > JSXAttribute > JSXIdentifier[name!=/^(?:phase|criterion|skin|size|locked|className|key|ref|className|style|children)$/]",
        "message": "<Crest> doesn't accept that prop. Declared props: phase, criterion, skin, size, locked, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCardData'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|body|doneWhen|bandVariant|state|phase|liveMoment|reviewNote|verifierComment|key|ref|className|style|children)$/]",
        "message": "<TaskCardData> doesn't accept that prop. Declared props: id, title, body, doneWhen, bandVariant, state, phase, liveMoment, reviewNote, verifierComment."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarginNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:entry|className|key|ref|className|style|children)$/]",
        "message": "<MarginNote> doesn't accept that prop. Declared props: entry, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:phase|criteriaCleared|tasksVerified|tasksTotal|status|sealedDate|reviewer|className|key|ref|className|style|children)$/]",
        "message": "<PhaseRow> doesn't accept that prop. Declared props: phase, criteriaCleared, tasksVerified, tasksTotal, status, sealedDate, reviewer, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:locked|active|review|sealed)$/]",
        "message": "<PhaseRow> status must be one of 'locked' | 'active' | 'review' | 'sealed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CelebrationStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<CelebrationStat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|total|perPhase|label|className|key|ref|className|style|children)$/]",
        "message": "<ProgressMeter> doesn't accept that prop. Declared props: value, total, perPhase, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|key|ref|className|style|children)$/]",
        "message": "<EvidenceItem> doesn't accept that prop. Declared props: kind, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seal'] > JSXAttribute > JSXIdentifier[name!=/^(?:phase|skin|size|sealed|date|animate|className|key|ref|className|style|children)$/]",
        "message": "<Seal> doesn't accept that prop. Declared props: phase, skin, size, sealed, date, animate, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkinToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<SkinToggle> doesn't accept that prop. Declared props: value, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|className|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: state, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrailStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|state|phase|label|onClick|className|key|ref|className|style|children)$/]",
        "message": "<TrailStep> doesn't accept that prop. Declared props: index, state, phase, label, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='WisdomEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|attribution|original|key|ref|className|style|children)$/]",
        "message": "<WisdomEntry> doesn't accept that prop. Declared props: text, attribution, original."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
